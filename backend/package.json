{
  "name": "panela-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do Times de Society",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js tests/unit/**/*.test.js",
    "test:integration": "node tests/run.js tests/integration/**/*.test.js",
    "db:create": "node --env-file=.env scripts/createDevDb.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "17.11.0-beta.19"
  }
}
