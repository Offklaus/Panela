# Copie para .env e ajuste. O .env nunca vai para o repositório.

# Porta da API
PORT=3000

# development ou production
NODE_ENV=development

# Arquivo do SQLite, relativo à pasta backend/
DATABASE_PATH=data/panela.sqlite

# Endereço da tela, usado no link de recuperação de senha
APP_URL=http://localhost:5173

# Opcional: pasta do frontend compilado para servir na mesma origem (ex.: ../frontend/dist)
FRONTEND_DIST_DIR=

# E-mail (obrigatório em produção). Sem SMTP_HOST, o link sai no log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Times de Society <no-reply@exemplo.com>
